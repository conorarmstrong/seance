# Ignoring target directory
target/

# Ignoring editor/IDE specific files
.vscode/
.idea/
*.iml
.DS_Store

# Ignoring OS generated files
.project
.settings/
Thumbs.db

# Ignoring build/dependency management files
# Cargo.lock

# Ignoring workspace runtime directory
workspace/

# Ignoring test data
/test_data/

# Generated golden-image corpus (built by scripts/build_golden_images.sh)
/golden_images/

# Ignoring other common files
*.log
*.env
.env.local

# Temporary files and directories generated by Gemini
.gemini/

# Ignore references
reference/

# Ignore SQLite databases
*.sqlite
*.db
*.sqlite3
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal

# ...except committed test fixtures. `*.db` above exists to keep real case
# databases out of the tree, and it silently swallowed the SQLCipher
# interoperability fixture: ignored files do not appear in `git status`, so
# `git add -A` skipped it without complaint and the test that verifies the
# per-page HMAC against SQLCipher's own output would have failed to compile on
# a fresh clone. Anything under a `tests/fixtures/` directory is deliberate.
#
# `**` after `fixtures/` because the first form, `!**/tests/fixtures/*.db`,
# matched one directory level only: the Magnet 2022 iOS fixtures live at
# `tests/fixtures/magnet2022_ios15/Library/Safari/Bookmarks.db`, so sixteen of
# the seventeen files stayed ignored and the crate's known-answer tests would
# have panicked on a fresh clone. The `-wal` sibling is part of the evidence
# (a WAL-mode database's newest rows live there) and is kept with it; `-shm`
# is a rebuilt shared-memory index and stays ignored.
!**/tests/fixtures/**/*.db
!**/tests/fixtures/**/*.sqlite
!**/tests/fixtures/**/*.sqlite3
!**/tests/fixtures/**/*.db-wal
!**/tests/fixtures/**/*.sqlite-wal

# The Magnet 2022 iOS 15 device files are not redistributed. Place them here from the
# published extraction to run the known-answer tests; see the README beside them.
seance_plugin_ios_artifacts/tests/fixtures/magnet2022_ios15/*
!seance_plugin_ios_artifacts/tests/fixtures/magnet2022_ios15/README.md

# Ignore test workspaces
test_workspace_*/
workspace/

# Ignore release builds
release/
# Node dependencies and frontend build output
node_modules/
frontend/dist/

# Fuzz corpus (generated by cargo-fuzz). Crash reproducers under
# fuzz/artifacts/ ARE tracked (TEST-003): seance_tests::fuzz_regression_tests
# replays them, and an untracked copy was lost to a disk prune on 2026-09-24.
fuzz/corpus/

# Local tooling state
.claude/

# Coverage output (cargo-tarpaulin / llvm-cov)
*.profraw
*.profdata
tarpaulin-report.*
cobertura.xml
lcov.info

# Rust / editor / OS scratch files
*.rs.bk
*.swp
*.swo
*~
*.bak
*.orig
*.rej
._*

# Python bytecode (fuzz/gen_seeds.py and other helper scripts)
__pycache__/
*.pyc

# Environment files (in addition to *.env / .env.local above)
.env
.env.*

# Local GitHub credential extracted from keychain (never commit)
.secrets/
webdata/

# ── Memory captures and swap areas ────────────────────────────────────────────
# Never commit these. A memory capture and a swap area hold live process memory:
# credentials, private keys, session tokens, and anything a user typed. They are
# acquired for testing, kept outside the repository, and referenced through
# environment variables by the corpus gate (see documentation/TESTING.md).
#
# The patterns are here as a safety net rather than as the primary control --
# the primary control is that these files live in ~/forensic_corpora, not in the
# tree. The `*.db` rule above taught the lesson that an ignore rule you rely on
# should be one you have actually tested.
*.lime
*.lime.compressed
*.avml
*.raw
*.mem
*.vmem
*.dmp
swapfile
swapfile.*
*.swapfile
pagefile.sys

# Tantivy search index built at runtime beside a workspace. Regenerated on
# demand and hundreds of MB, so it never belongs in the repository.
search_index/

# Working notes from a UI/UX review pass. They are scratch for whoever is doing
# the work — file-and-line findings against a tree that is already moving — and
# go stale the moment the fixes land. The durable record of a defect belongs in
# BUGS.md, not here.
.review/
.review-ui/

# Symbol stores fetched for a case: large generated ISF, not source.
/symbols/
/golden_images/
